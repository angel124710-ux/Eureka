-- Função auxiliar: cria um TextBox padrão (campo numérico)

local function makeTextBox(order, placeholder)
	local box = Instance.new("TextBox")
	box.LayoutOrder = order
	box.Parent = content
	box.Size = UDim2.new(0.92, 0, 0, 26)
	box.PlaceholderText = placeholder
	box.Text = ""
	box.Font = Enum.Font.Gotham
	box.TextScaled = true
	box.ClearTextOnFocus = false
	box.BackgroundColor3 = Color3.fromRGB(235, 235, 245)
	box.TextColor3 = Color3.fromRGB(30, 30, 40)

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 7)
	c.Parent = box

	local p = Instance.new("UIPadding")
	p.PaddingLeft = UDim.new(0, 8)
	p.PaddingRight = UDim.new(0, 8)
	p.Parent = box

	return box
end

-- Função auxiliar: cria um TextButton padrão (botão de ação/toggle)

local function makeButton(order, text, color)
	local btn = Instance.new("TextButton")
	btn.LayoutOrder = order
	btn.Parent = content
	btn.Size = UDim2.new(0.92, 0, 0, 26)
	btn.Text = text
	btn.Font = Enum.Font.GothamBold
	btn.TextScaled = true
	btn.BackgroundColor3 = color
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.AutoButtonColor = true

	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, 7)
	c.Parent = btn

	return btn
end

