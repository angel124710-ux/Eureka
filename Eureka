local opened = true

local function setOpened(state)
	opened = state

	if opened then
		toggle.Text = "-"
		line.Visible = true
		content.Visible = true

		TweenService:Create(
			gui,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad),
			{Size = FULL_SIZE}
		):Play()
	else
		toggle.Text = "+"

		TweenService:Create(
			gui,
			TweenInfo.new(0.18, Enum.EasingStyle.Quad),
			{Size = MINI_SIZE}
		):Play()

		task.delay(0.18, function()
			if not opened then
				line.Visible = false
				content.Visible = false
			end
		end)
	end
end

toggle.Activated:Connect(function()
	setOpened(not opened)
end)

-- FEEDBACK VISUAL

local function showStatus(text)
	statusLabel.Text = text
	task.delay(2, function()
		if statusLabel and statusLabel.Text == text then
			statusLabel.Text = ""
		end
	end)
end

-- WALKSPEED

local function activateSpeed()
	local value = tonumber(speedBox.Text) or 16
	value = math.clamp(value, 1, 500)
	lastWalkSpeed = value

	if humanoid then
		humanoid.WalkSpeed = value
	end

	showStatus("Speed ativado: " .. tostring(value))
end

activateBtn.Activated:Connect(activateSpeed)
speedBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then activateSpeed() end
end)

-- JUMPPOWER

local function activateJumpPower()
	local value = tonumber(jumpBox.Text) or 50
	value = math.clamp(value, 1, 500)
	lastJumpPower = value

	if humanoid then
		humanoid.UseJumpPower = true
		humanoid.JumpPower = value
	end

	showStatus("JumpPower ativado: " .. tostring(value))
end

jumpBtn.Activated:Connect(activateJumpPower)
jumpBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then activateJumpPower() end
end)

-- NOCLIP

local noclipEnabled = false
local noclipConn = nil

local function setNoclip(state)
	noclipEnabled = state
	noclipBtn.Text = noclipEnabled and "Noclip: ON" or "Noclip: OFF"
	noclipBtn.BackgroundColor3 = noclipEnabled and ON_COLOR or OFF_COLOR

	if noclipEnabled then
		noclipConn = RunService.Stepped:Connect(function()
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	else
		if noclipConn then
			noclipConn:Disconnect()
			noclipConn = nil
		end
		if character then
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					part.CanCollide = true
				end
			end
		end
	end

	showStatus("Noclip: " .. (noclipEnabled and "ativado" or "desativado"))
end

noclipBtn.Activated:Connect(function()
	setNoclip(not noclipEnabled)
end)

-- INFINITE JUMP

local infiniteJumpEnabled = false

local function setInfiniteJump(state)
	infiniteJumpEnabled = state
	infJumpBtn.Text = infiniteJumpEnabled and "Infinite Jump: ON" or "Infinite Jump: OFF"
	infJumpBtn.BackgroundColor3 = infiniteJumpEnabled and ON_COLOR or OFF_COLOR
	showStatus("Infinite Jump: " .. (infiniteJumpEnabled and "ativado" or "desativado"))
end

infJumpBtn.Activated:Connect(function()
	setInfiniteJump(not infiniteJumpEnabled)
end)

UserInputService.JumpRequest:Connect(function()
	if infiniteJumpEnabled and humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- ESP (contorno nos outros jogadores, visível através de parede)

local ESP_COLOR = Color3.fromRGB(255, 60, 60)
local espEnabled = false
local espHighlights = {}

local function addESP(plr)
	if plr == player then return end
	local char = plr.Character
	if not char then return end

	local existing = char:FindFirstChild("GhostESP")
	if existing then existing:Destroy() end

	local highlight = Instance.new("Highlight")
	highlight.Name = "GhostESP"
	highlight.FillColor = ESP_COLOR
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Enabled = espEnabled
	highlight.Parent = char

	espHighlights[plr] = highlight
end

local function removeESP(plr)
	local h = espHighlights[plr]
	if h then
		h:Destroy()
		espHighlights[plr] = nil
	end
end

local function setESP(state)
	espEnabled = state
	espBtn.Text = espEnabled and "ESP: ON" or "ESP: OFF"
	espBtn.BackgroundColor3 = espEnabled and ON_COLOR or OFF_COLOR

	for _, h in pairs(espHighlights) do
		h.Enabled = espEnabled
	end

	showStatus("ESP: " .. (espEnabled and "ativado" or "desativado"))
end

espBtn.Activated:Connect(function()
	setESP(not espEnabled)
end)

for _, plr in ipairs(Players:GetPlayers()) do
	addESP(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(0.2)
		addESP(plr)
	end)
end

Players.PlayerAdded:Connect(function(plr)
	addESP(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(0.2)
		addESP(plr)
	end)
end)

Players.PlayerRemoving:Connect(removeESP)

-- LOOP PRINCIPAL
-- Em vez de depender de CharacterAdded/Died (que podem falhar por causa
-- de ordem de eventos), checamos TODO FRAME se o personagem atual ainda
-- é válido. Se for um personagem novo (respawn), gruda direto nele sem
-- "voar" pela tela. Isso corrige o painel sumir/travar após morrer.

RunService.RenderStepped:Connect(function()

	local char = player.Character
	local liveRoot = char and char:FindFirstChild("HumanoidRootPart")
	local liveHumanoid = char and char:FindFirstChild("Humanoid")

	if not (liveRoot and liveHumanoid and liveHumanoid.Health > 0) then
		gui.Enabled = false
		return
	end

	gui.Enabled = true

	if root ~= liveRoot then
		-- Personagem novo detectado (primeiro spawn ou respawn)
		character = char
		root = liveRoot
		humanoid = liveHumanoid

		local snapPos =
			root.Position +
			root.CFrame.RightVector * RIGHT_OFFSET +
			Vector3.new(0, HEIGHT_OFFSET, 0)

		currentPos = snapPos
		holder.Position = snapPos

		-- Reaplica os últimos valores configurados
		if lastWalkSpeed then
			humanoid.WalkSpeed = lastWalkSpeed
		end
		if lastJumpPower then
			humanoid.UseJumpPower = true
			humanoid.JumpPower = lastJumpPower
		end
	end

	local t = tick()

	local offset =
		root.CFrame.LookVector * FORWARD_OFFSET +
		root.CFrame.RightVector * RIGHT_OFFSET +
		Vector3.new(0, HEIGHT_OFFSET + math.sin(t * 2) * 0.08, 0)

	local targetPos = root.Position + offset

	currentPos = currentPos:Lerp(targetPos, 0.1)
	holder.Position = currentPos

	stroke.Transparency =
		0.45 + math.abs(math.sin(t * 2)) * 0.2

end)
